# Keep the staging address (and preview builds) out of search results. These rules match only the *.pages.dev
# hostnames, so www.evanssion.com is unaffected and stays indexable.
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' '{{HEAD_JS_HASH}}' https://challenges.cloudflare.com https://client.crisp.chat; style-src 'self' 'unsafe-inline' https://client.crisp.chat; img-src 'self' data: https://*.crisp.chat; font-src 'self' https://client.crisp.chat; connect-src 'self' https://challenges.cloudflare.com https://*.crisp.chat wss://*.crisp.chat; media-src 'self' https://*.crisp.chat; worker-src 'self' blob:; frame-src https://challenges.cloudflare.com https://*.crisp.chat https://*.crisp.help; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

/assets/img/*
  Cache-Control: public, max-age=604800

/assets/site.css
  Cache-Control: public, max-age=31536000, immutable

/assets/site.js
  Cache-Control: public, max-age=31536000, immutable

/assets/mark.png
  Cache-Control: public, max-age=31536000, immutable

/api/*
  Cache-Control: no-store
